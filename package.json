{
  "name": "@tracht-digital-solutions/tds-shared",
  "version": "0.2.0",
  "description": "Shared TypeScript types, Zod schemas, i18n strings, brand tokens, and motion presets used across the TDS frontends.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "require": "./dist/schemas/index.cjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js",
      "require": "./dist/i18n/index.cjs"
    },
    "./i18n/react": {
      "types": "./dist/i18n/react.d.ts",
      "import": "./dist/i18n/react.js",
      "require": "./dist/i18n/react.cjs"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "import": "./dist/motion/index.js",
      "require": "./dist/motion/index.cjs"
    },
    "./brand": {
      "types": "./dist/brand/tokens.d.ts",
      "import": "./dist/brand/tokens.js",
      "require": "./dist/brand/tokens.cjs"
    },
    "./brand/tailwind-preset": {
      "types": "./dist/brand/tailwind-preset.d.ts",
      "import": "./dist/brand/tailwind-preset.js",
      "require": "./dist/brand/tailwind-preset.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tracht-Digital-Solutions/tds-shared.git"
  }
}
